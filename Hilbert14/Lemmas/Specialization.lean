import Mathlib.Algebra.Polynomial.Derivative
import Mathlib.Algebra.Polynomial.Laurent
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.Algebra.Algebra.Subalgebra.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Operations

/-! The characteristic-zero cusp obstruction used in the specialization step.
The iterated polynomial rings express the cusp after a coordinate shift.
`SpecializationBridge` applies the resulting Laurent-polynomial intersection
criterion to every element of the explicit field intersection. -/
namespace Hilbert14

open Polynomial

variable (R : Type*) [CommRing R]

/-- Polynomials with zero first-order coefficient form a subalgebra. -/
noncomputable def noLinearTerm : Subalgebra R R[X] where
  carrier := {p | p.derivative.eval 0 = 0}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by intro p q hp hq; simp_all
  mul_mem' := by intro p q hp hq; simp_all [derivative_mul]
  algebraMap_mem' := by intro r; simp

/-- The cusp algebra R[w²,w³], allowing arbitrary coefficients in R. -/
noncomputable def cuspAlgebra : Subalgebra R R[X] :=
  Algebra.adjoin R {(X : R[X]) ^ 2, (X : R[X]) ^ 3}

theorem cuspAlgebra_le_noLinearTerm : cuspAlgebra R ≤ noLinearTerm R := by
  apply Algebra.adjoin_le
  intro p hp
  rcases hp with rfl | hp
  · change (derivative ((X : R[X]) ^ 2)).eval 0 = 0
    simp
  · rcases hp with rfl | hp
    · change (derivative ((X : R[X]) ^ 3)).eval 0 = 0
      simp

variable {k : Type*} [Field k]

/-- Rewrite p(z) in coordinates t=z+w, giving p(t-w). -/
noncomputable def cuspTranslate (p : k[X]) : (k[X])[X] :=
  (p.map C).comp (C X - X)

theorem derivative_cuspTranslate_eval_zero (p : k[X]) :
    (cuspTranslate p).derivative.eval 0 = -p.derivative := by
  simp [cuspTranslate, derivative_comp, eval_comp, eval_map]

/-- If p(t-w) is a polynomial in w²,w³ with polynomial t-coefficients,
then p is constant, since its derivative vanishes in characteristic zero. -/
theorem eq_constant_of_cuspTranslate_mem [CharZero k] (p : k[X])
    (hp : cuspTranslate p ∈ cuspAlgebra k[X]) : p = C (p.coeff 0) := by
  have h := cuspAlgebra_le_noLinearTerm k[X] hp
  change (cuspTranslate p).derivative.eval 0 = 0 at h
  rw [derivative_cuspTranslate_eval_zero, neg_eq_zero] at h
  exact eq_C_of_derivative_eq_zero h

/-- A differential constraint satisfied by k[w²,w³,z+w]. The outer variable
is w and the inner variable is z; both sides are evaluated at w=0. -/
noncomputable def cuspDifferentialConstraint : Subalgebra k (k[X])[X] where
  carrier := {p | p.derivative.eval 0 = (p.eval 0).derivative}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by intro p q hp hq; simp_all
  mul_mem' := by intro p q hp hq; simp_all [derivative_mul]
  algebraMap_mem' := by intro r; simp

/-- The polynomial ring generated by w²,w³,z+w inside k[z][w]. -/
noncomputable def shiftedCusp : Subalgebra k (k[X])[X] :=
  Algebra.adjoin k {(X : (k[X])[X]) ^ 2, (X : (k[X])[X]) ^ 3, C X + X}

theorem shiftedCusp_le_constraint : shiftedCusp (k := k) ≤ cuspDifferentialConstraint := by
  apply Algebra.adjoin_le
  intro p hp
  rcases hp with rfl | hp
  · change (derivative ((X : (k[X])[X]) ^ 2)).eval 0 = _
    simp
  · rcases hp with rfl | hp
    · change (derivative ((X : (k[X])[X]) ^ 3)).eval 0 = _
      simp
    · rcases hp with rfl
      change (derivative (C X + X : (k[X])[X])).eval 0 = _
      simp

/-- The unshifted cusp intersection: a polynomial p(z) belonging to
k[w²,w³,z+w] must be constant. -/
theorem eq_constant_of_C_mem_shiftedCusp [CharZero k] (p : k[X])
    (hp : C p ∈ shiftedCusp) : p = C (p.coeff 0) := by
  have h := shiftedCusp_le_constraint hp
  change (derivative (C p)).eval 0 = ((C p).eval 0).derivative at h
  simp only [derivative_C, eval_zero, eval_C] at h
  exact eq_C_of_derivative_eq_zero h.symm

/-- Positive and negative polynomial powers intersect only in constants.
The coefficient ring can itself be k[z], so this forces independence of x
before applying the shifted-cusp obstruction. -/
theorem eq_constant_of_laurent_eq_invert (p q : R[X])
    (h : p.toLaurent = LaurentPolynomial.invert q.toLaurent) :
    p = C (p.coeff 0) := by
  ext n
  by_cases hn : n = 0
  · subst n
    simp
  · have hc := congrArg (fun f : LaurentPolynomial R => f.coeff (n : ℤ)) h
    rw [LaurentPolynomial.invert_apply] at hc
    have hnegative : q.toLaurent.coeff (-(n : ℤ)) = 0 := by
      apply Finsupp.notMem_support_iff.mp
      rw [LaurentPolynomial.support_coeff_toLaurent]
      intro hmem
      obtain ⟨m, _, hm⟩ := Finset.mem_map.mp hmem
      have hmnonneg : (0 : ℤ) ≤ m := Int.natCast_nonneg m
      have hnpos : (0 : ℤ) < n := Int.natCast_pos.mpr (Nat.pos_of_ne_zero hn)
      change (m : ℤ) = -(n : ℤ) at hm
      rw [hm] at hmnonneg
      exact (not_le_of_gt (neg_neg_of_pos hnpos)) hmnonneg
    rw [hnegative] at hc
    have hpositive : p.toLaurent.coeff (n : ℤ) = p.coeff n := by
      exact Finsupp.mapDomain_apply_of_injective Nat.cast_injective _ n
    rw [hpositive] at hc
    simpa only [coeff_C, ite_eq_right hn] using hc

/-- Full polynomial/Laurent specialization obstruction. If a polynomial
in x,z equals a polynomial in x⁻²,x⁻³,z+x⁻¹, it is scalar. Here the latter
representation is recorded by a polynomial q in w,z belonging to the
explicitly generated shifted cusp, with w=x⁻¹. -/
theorem eq_scalar_of_laurent_eq_shiftedCusp [CharZero k]
    (p q : (k[X])[X])
    (h : p.toLaurent = LaurentPolynomial.invert q.toLaurent)
    (hq : q ∈ shiftedCusp) :
    p = C (C ((p.coeff 0).coeff 0)) := by
  have hp := eq_constant_of_laurent_eq_invert k[X] p q h
  have hqq := congrArg LaurentPolynomial.invert h
  rw [hp, Polynomial.toLaurent_C, LaurentPolynomial.invert_C,
    LaurentPolynomial.involutive_invert q.toLaurent] at hqq
  have hqeq : q = C (p.coeff 0) := by
    apply Polynomial.toLaurent_injective
    simpa only [Polynomial.toLaurent_C] using hqq.symm
  have hc : p.coeff 0 = C ((p.coeff 0).coeff 0) := by
    apply eq_constant_of_C_mem_shiftedCusp
    rwa [hqeq] at hq
  exact hp.trans (congrArg C hc)

#print axioms eq_constant_of_cuspTranslate_mem
#print axioms eq_constant_of_C_mem_shiftedCusp
#print axioms eq_constant_of_laurent_eq_invert
#print axioms eq_scalar_of_laurent_eq_shiftedCusp

end Hilbert14
